# LeadHub configuration.  Copy this file to ".env" and adjust.  NEVER commit ".env".
# Every value here is a safe default; the app runs with none of them set.

# ── storage ──────────────────────────────────────────────────────────────────
# Where the SQLite database and runtime files live. Keep this OUTSIDE any folder
# a web server or static host could serve. Defaults to the app folder for the
# existing single-PC install.
LEADHUB_DATA_DIR=./data

# ── http server ──────────────────────────────────────────────────────────────
# Bind to 127.0.0.1 when a reverse proxy / hosting platform terminates HTTPS in
# front of the app; keep 0.0.0.0 only for the trusted-LAN install.
LEADHUB_BIND=0.0.0.0
LEADHUB_PORT=80
LEADHUB_FALLBACK_PORT=8000

# ── sessions & auth ──────────────────────────────────────────────────────────
LEADHUB_SESSION_HOURS=12          # idle timeout (sliding)
LEADHUB_SESSION_MAX_HOURS=24      # absolute max session age, then re-login
LEADHUB_PIN_MIN=4                 # minimum PIN length for agents
LEADHUB_ADMIN_PIN_MIN=6           # minimum PIN length for admins
LEADHUB_MAX_PIN_FAILS=5
LEADHUB_PIN_LOCK_SECONDS=120
LEADHUB_PBKDF2_ROUNDS=240000

# ── transport / headers ──────────────────────────────────────────────────────
# Set to 1 in production (behind HTTPS) to send HSTS and upgrade-insecure hints.
LEADHUB_ENFORCE_HTTPS=0

# ── branding (per client) ────────────────────────────────────────────────────
LEADHUB_BRAND_NAME=LeadHub
LEADHUB_BRAND_ACCENT=#4f4ff0

# ── seed (optional, first run only, when DB is empty) ────────────────────────
LEADHUB_SEED_CSV=
